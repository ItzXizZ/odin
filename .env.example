ANTHROPIC_API_KEY=sk-ant-your-key-here
PORT=3001

# Supabase — cloud persistence (optional; app falls back to localStorage if unset).
# Find these in your Supabase project: Settings → API.
# The SECRET key bypasses Row Level Security — keep it server-side only, never commit it.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your-secret-key-here
# Storage buckets (auto-created on server start). Assets is public; state is private.
SUPABASE_ASSETS_BUCKET=odin-assets
SUPABASE_STATE_BUCKET=odin-state

# Frontend Google auth (safe to expose to the browser).
# - VITE_SUPABASE_URL: same project URL as SUPABASE_URL above.
# - VITE_SUPABASE_ANON_KEY: the publishable / "anon" key (Settings → API).
# When both are set, the app requires Google sign-in and stores each person's
# data under their own account. Leave the anon key blank for local mode (no login).
# You must also enable the Google provider in Supabase: Authentication → Providers
# → Google, and add these redirect URLs under Authentication → URL Configuration:
#   http://localhost:5173/
#   http://localhost:5173/signup-complete
#   https://odinwrite.com/
#   https://odinwrite.com/signup-complete
# Sign-up after the tutorial uses /signup-complete (Google Ads conversion page).
# Returning sign-in uses /.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your-anon-key-here

# Optional — enables higher-quality web research (free tier at tavily.com)
# Without this, DuckDuckGo is used as a fallback.
TAVILY_API_KEY=

# Image generation — listed in priority order (first match wins for AI visuals)
# Recommended: OpenAI for ChatGPT-quality images (platform.openai.com)
OPENAI_API_KEY=

# Alternative: Google Gemini Imagen (aistudio.google.com)
GOOGLE_API_KEY=

# Fallback: Replicate Flux Pro (replicate.com)
REPLICATE_API_KEY=
